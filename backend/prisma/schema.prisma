generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// USER ROLE
// ============================================================

enum UserRole {
  PATIENT
  CAREGIVER
}

// ============================================================
// USER
// ============================================================

model User {
  id       String @id @default(cuid())
  fullName String
  email    String @unique
  password String

  role UserRole @default(PATIENT)

  // Patient connection code
  // Example: SC-PAT-7K4P9X
  patientCode String? @unique

  // Basic profile
  age         Int?
  phone       String?
  dateOfBirth DateTime?
  gender      String?
  address     String?
  city        String?

  // Health information
  bloodGroup   String?
  medicalNotes String?

  // Profile photo
  profileImageUrl String?

  // Preferences
  language        String  @default("English")
  caregiverName   String?
  caregiverAccess Boolean @default(false)
  gpsSharing      Boolean @default(false)
  textSize        String  @default("Normal")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Existing relationships
  emergencyContacts EmergencyContact[]
  tasks             Task[]
  memories          Memory[]
  gameResults       GameResult[]
  cognitiveScores   CognitiveScore[]
  patientLocation   PatientLocation?

  // Caregiver ↔ Patient relationships
  caregiverConnections CaregiverPatient[] @relation("CaregiverConnections")
  patientConnections   CaregiverPatient[] @relation("PatientConnections")

  // Caregiver invitations
  caregiverInvites CaregiverInvite[] @relation("CaregiverInvites")

  // Alert relationships
  patientAlerts   Alert[] @relation("PatientAlerts")
  caregiverAlerts Alert[] @relation("CaregiverAlerts")
}

// ============================================================
// CAREGIVER ↔ PATIENT CONNECTION
// ============================================================

model CaregiverPatient {
  id String @id @default(cuid())

  caregiverId String
  patientId   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caregiver User @relation("CaregiverConnections", fields: [caregiverId], references: [id], onDelete: Cascade)
  patient   User @relation("PatientConnections", fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([caregiverId, patientId])
  @@index([caregiverId])
  @@index([patientId])
}

// ============================================================
// CAREGIVER INVITE
// ============================================================

model CaregiverInvite {
  id String @id @default(cuid())

  caregiverId String
  code        String @unique

  expiresAt DateTime?
  used      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caregiver User @relation("CaregiverInvites", fields: [caregiverId], references: [id], onDelete: Cascade)

  @@index([caregiverId])
  @@index([code])
  @@index([expiresAt])
}

// ============================================================
// EMERGENCY CONTACT
// ============================================================

model EmergencyContact {
  id           String   @id @default(cuid())
  userId       String
  name         String
  relationship String
  phone        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================
// TASK / SCHEDULE
// ============================================================

model Task {
  id              String   @id @default(cuid())
  userId          String
  title           String
  description     String?
  category        String?
  scheduledAt     DateTime
  completed       Boolean  @default(false)
  reminderEnabled Boolean  @default(true)
  repeatType      String   @default("NONE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([scheduledAt])
}

// ============================================================
// MEMORY
// ============================================================

model Memory {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  imageUrl    String?
  audioUrl    String?
  category    String?
  type        String   @default("text")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================
// GAME
// ============================================================

model Game {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  category    String?
  difficulty  String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  results GameResult[]
}

// ============================================================
// GAME RESULT
// ============================================================

model GameResult {
  id       String   @id @default(cuid())
  userId   String
  gameId   String
  score    Int
  duration Int?
  playedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([gameId])
  @@index([playedAt])
}

// ============================================================
// COGNITIVE SCORE
// ============================================================

model CognitiveScore {
  id         String   @id @default(cuid())
  userId     String
  score      Int
  memory     Int?
  attention  Int?
  reaction   Int?
  recordedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([recordedAt])
}

// ============================================================
// PATIENT GPS LOCATION
// ============================================================

model PatientLocation {
  id        String   @id @default(cuid())
  patientId String   @unique

  latitude  Float
  longitude Float
  accuracy  Float?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

// ============================================================
// ALERT STATUS
// ============================================================

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

// ============================================================
// ALERT SOURCE TYPE
// ============================================================

enum AlertSourceType {
  TASK
  HYDRATION
  GAME
  MANUAL
}

// ============================================================
// CAREGIVER ALERT
// ============================================================

model Alert {
  id          String          @id @default(cuid())
  patientId   String
  caregiverId String

  category    String
  typeLabel   String
  title       String
  description String          @db.Text
  badge       String

  status      AlertStatus     @default(ACTIVE)
  sourceType  AlertSourceType @default(TASK)
  sourceId    String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  patient   User @relation("PatientAlerts", fields: [patientId], references: [id], onDelete: Cascade)
  caregiver User @relation("CaregiverAlerts", fields: [caregiverId], references: [id], onDelete: Cascade)

  @@unique([caregiverId, sourceType, sourceId])
  @@index([patientId])
  @@index([caregiverId])
  @@index([status])
  @@index([createdAt])
  @@index([sourceType, sourceId])
}