generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id                   String             @id @default(cuid())
  fullName             String
  email                String             @unique
  password             String
  role                 UserRole           @default(PATIENT)
  patientCode          String?            @unique
  age                  Int?
  phone                String?
  dateOfBirth          DateTime?
  gender               String?
  address              String?
  city                 String?
  bloodGroup           String?
  medicalNotes         String?
  profileImageUrl      String?
  language             String             @default("English")
  caregiverName        String?
  caregiverAccess      Boolean            @default(false)
  gpsSharing           Boolean            @default(false)
  textSize             String             @default("Normal")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  caregiverAlerts      Alert[]            @relation("CaregiverAlerts")
  patientAlerts        Alert[]            @relation("PatientAlerts")
  caregiverInvites     CaregiverInvite[]  @relation("CaregiverInvites")
  caregiverConnections CaregiverPatient[] @relation("CaregiverConnections")
  patientConnections   CaregiverPatient[] @relation("PatientConnections")
  cognitiveScores      CognitiveScore[]
  emergencyContacts    EmergencyContact[]
  gameResults          GameResult[]
  memories             Memory[]
  patientLocation      PatientLocation?
  tasks                Task[]
}

model CaregiverPatient {
  id          String   @id @default(cuid())
  caregiverId String
  patientId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  caregiver   User     @relation("CaregiverConnections", fields: [caregiverId], references: [id], onDelete: Cascade)
  patient     User     @relation("PatientConnections", fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([caregiverId, patientId])
  @@index([caregiverId])
  @@index([patientId])
}

model CaregiverInvite {
  id          String    @id @default(cuid())
  caregiverId String
  code        String    @unique
  expiresAt   DateTime?
  used        Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  caregiver   User      @relation("CaregiverInvites", fields: [caregiverId], references: [id], onDelete: Cascade)

  @@index([caregiverId])
  @@index([code])
  @@index([expiresAt])
}

model EmergencyContact {
  id           String   @id @default(cuid())
  userId       String
  name         String
  relationship String
  phone        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Task {
  id              String   @id @default(cuid())
  userId          String
  title           String
  description     String?
  category        String?
  scheduledAt     DateTime
  completed       Boolean  @default(false)
  reminderEnabled Boolean  @default(true)
  repeatType      String   @default("NONE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([scheduledAt])
}

model Memory {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  imageUrl    String?
  audioUrl    String?
  category    String?
  type        String   @default("text")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Game {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  category    String?
  difficulty  String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  results     GameResult[]
}

model GameResult {
  id       String   @id @default(cuid())
  userId   String
  gameId   String
  score    Int
  duration Int?
  playedAt DateTime @default(now())
  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([gameId])
  @@index([playedAt])
}

model CognitiveScore {
  id         String   @id @default(cuid())
  userId     String
  score      Int
  memory     Int?
  attention  Int?
  reaction   Int?
  recordedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([recordedAt])
}

model PatientLocation {
  id        String   @id @default(cuid())
  patientId String   @unique
  latitude  Float
  longitude Float
  accuracy  Float?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  patient   User     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model Alert {
  id             String          @id @default(cuid())
  patientId      String
  caregiverId    String
  category       String
  typeLabel      String
  title          String
  description    String          @db.Text
  badge          String
  status         AlertStatus     @default(ACTIVE)
  sourceType     AlertSourceType @default(TASK)
  sourceId       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  caregiver      User            @relation("CaregiverAlerts", fields: [caregiverId], references: [id], onDelete: Cascade)
  patient        User            @relation("PatientAlerts", fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([caregiverId, sourceType, sourceId])
  @@index([patientId])
  @@index([caregiverId])
  @@index([status])
  @@index([createdAt])
  @@index([sourceType, sourceId])
}

enum UserRole {
  PATIENT
  CAREGIVER
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

enum AlertSourceType {
  TASK
  HYDRATION
  GAME
  MANUAL
}
